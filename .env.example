# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: HTTP & Socket.io port for server.ts (defaults to 3000 locally).
PORT="3000"

# ALLOWED_ORIGINS: Comma-separated list of browser origins allowed to connect to Socket.io.
# https://adlensalerts-collab.github.io is always allowed by default.
ALLOWED_ORIGINS="https://adlensalerts-collab.github.io"

# PUBLIC_ORIGIN: Optional canonical origin of the deployed Node service itself
# (e.g., https://thela-dhaka.onrender.com).
PUBLIC_ORIGIN=""

# VITE_SERVER_URL: Build-time Socket.io backend URL for static frontends (e.g. GitHub Pages).
# Leave empty when serving frontend + Socket.io from the same Node origin.
VITE_SERVER_URL=""

# VITE_STATIC_HOST: Set to "true" when building for a static-only host (e.g. GitHub Pages).
VITE_STATIC_HOST="false"

# GITHUB_PAGES: Set to "true" when building under the /Thela-Dhaka/ base path for GitHub Pages.
GITHUB_PAGES="false"

